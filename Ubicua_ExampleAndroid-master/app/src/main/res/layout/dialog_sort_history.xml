<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ordenar Por"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <RadioGroup
        android:id="@+id/radioGroupSortBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/radioSortByDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha" />

        <RadioButton
            android:id="@+id/radioSortByTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Temperatura" />

        <RadioButton
            android:id="@+id/radioSortByHumidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Humedad" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Orden"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <RadioGroup
        android:id="@+id/radioGroupSortOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/radioSortAsc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ascendente" />

        <RadioButton
            android:id="@+id/radioSortDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descendente" />
    </RadioGroup>

    <!-- NUEVO GRUPO DE FILTRO -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Limitar Resultados"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <RadioGroup
        android:id="@+id/radioGroupLimit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/radioLimitNone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Mostrar Todos" />

        <RadioButton
            android:id="@+id/radioLimit10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos 10" />

        <RadioButton
            android:id="@+id/radioLimit100"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos 100" />
    </RadioGroup>

    <Button
        android:id="@+id/buttonApplySort"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Aplicar Filtros" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Filtrar por Fecha Exacta"
        android:textAppearance="?attr/textAppearanceTitleMedium" />

    <Button
        android:id="@+id/buttonPickDate"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Seleccionar Fecha" />

    <Button
        android:id="@+id/buttonResetFilters"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="Limpiar Filtros" />

</LinearLayout>